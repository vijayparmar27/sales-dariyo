# ─── API & Content Origin ───────────────────────────────────────────
# The dryfish-backend API origin (no trailing slash).
# Used by the sales site to fetch dynamic About/Blog/Contact content and
# deliver quote submissions & contact form enquiries to the admin inbox.
# Unset, the site uses built-in fallback copy and holds submissions offline.
SITE_API_URL=http://localhost:9000

# Where uploaded images and media from the admin panel are served from.
# Blank falls back to SITE_API_URL. Set to your S3 or CDN origin if media
# is hosted separately from the API server.
SITE_ASSET_URL=http://localhost:9000

# ─── Image Optimization Allowlist ────────────────────────────────────
# Comma-separated list of additional external image domains allowed in
# Next.js image optimization (remotePatterns in next.config.ts).
# SITE_API_URL and SITE_ASSET_URL are automatically included.
SITE_IMAGE_HOSTS=

# ─── Network & Anti-Spam Rate Limiting ───────────────────────────────
# The header set by your reverse proxy / CDN containing the client IP
# for per-visitor enquiry rate limiting.
# - Cloudflare: cf-connecting-ip
# - Nginx: x-real-ip
# - Vercel / Standard: x-forwarded-for (default when unset)
SITE_VISITOR_IP_HEADER=

# ─── Server Port ─────────────────────────────────────────────────────
# Port for running the sales site dev / production server (default: 3200).
PORT=3200

